{
  "name": "medconnect",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:preview": "sh -c 'npm run dev:server & npm run dev --prefix client -- --host 0.0.0.0 --port 5000'",
    "build": "npm run build --prefix client",
    "lint": "npm run lint --prefix client",
    "start": "npm run start --prefix server",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "prisma:validate": "npm run prisma:validate --prefix server",
    "prisma:migrate": "npm run prisma:migrate --prefix server",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --prefix server",
    "prisma:seed": "npm run prisma:seed --prefix server",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "test": "npm test --prefix server"
  }
}
