{
  "info": {
    "name": "MedConnect API",
    "description": "Review-ready API collection for MedConnect authentication, appointments, queue, consultations, notifications, and staff flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api", "type": "string" },
    { "key": "jwtToken", "value": "", "type": "string" },
    { "key": "patientId", "value": "", "type": "string" },
    { "key": "doctorId", "value": "", "type": "string" },
    { "key": "appointmentId", "value": "", "type": "string" },
    { "key": "queueEntryId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Patient Demo\",\n  \"email\": \"patient@medconnect.local\",\n  \"password\": \"MedConnect123!\",\n  \"phone\": \"+1234567890\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"patient@medconnect.local\",\n  \"password\": \"MedConnect123!\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json(); if (body.token) { pm.collectionVariables.set('jwtToken', body.token); pm.collectionVariables.set('patientId', body.user.id); }"], "type": "text/javascript" } }]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "List patients (staff only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/patients", "host": ["{{baseUrl}}"], "path": ["patients"] }
          }
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "List doctors",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/doctors?available=true", "host": ["{{baseUrl}}"], "path": ["doctors"], "query": [{ "key": "available", "value": "true" }] }
          }
        },
        {
          "name": "Get doctor profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/doctors/{{doctorId}}", "host": ["{{baseUrl}}"], "path": ["doctors", "{{doctorId}}"] }
          }
        },
        {
          "name": "Create doctor (staff only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Dr. Maya Rao\",\n  \"email\": \"doctor@medconnect.local\",\n  \"password\": \"MedConnect123!\",\n  \"specialization\": \"General Medicine\",\n  \"availability\": \"AVAILABLE\"\n}" },
            "url": { "raw": "{{baseUrl}}/doctors", "host": ["{{baseUrl}}"], "path": ["doctors"] }
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Create appointment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"scheduledAt\": \"2026-09-22T10:30:00.000Z\"\n}" },
            "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json(); if (body.appointment) { pm.collectionVariables.set('appointmentId', body.appointment.id); }"], "type": "text/javascript" } }]
        },
        {
          "name": "List appointments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] }
          }
        },
        {
          "name": "Get appointment details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["appointments", "{{appointmentId}}"] }
          }
        },
        {
          "name": "Create walk-in (receptionist/admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"doctorId\": \"{{doctorId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/appointments/walk-in", "host": ["{{baseUrl}}"], "path": ["appointments", "walk-in"] }
          }
        },
        {
          "name": "Cancel appointment",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/appointments/{{appointmentId}}/cancel", "host": ["{{baseUrl}}"], "path": ["appointments", "{{appointmentId}}", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "Queue",
      "item": [
        {
          "name": "Get queue for appointment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/appointments/{{appointmentId}}/queue", "host": ["{{baseUrl}}"], "path": ["appointments", "{{appointmentId}}", "queue"] }
          }
        },
        {
          "name": "Doctor queue",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/doctors/{{doctorId}}/queue", "host": ["{{baseUrl}}"], "path": ["doctors", "{{doctorId}}", "queue"] }
          }
        },
        {
          "name": "Call next patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/queue/call-next", "host": ["{{baseUrl}}"], "path": ["queue", "call-next"] }
          }
        },
        {
          "name": "Start consultation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/queue/{{queueEntryId}}/start", "host": ["{{baseUrl}}"], "path": ["queue", "{{queueEntryId}}", "start"] }
          }
        },
        {
          "name": "Complete consultation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"notes\": \"Patient reviewed and advised on next steps.\"\n}" },
            "url": { "raw": "{{baseUrl}}/queue/{{queueEntryId}}/complete", "host": ["{{baseUrl}}"], "path": ["queue", "{{queueEntryId}}", "complete"] }
          }
        }
      ]
    },
    {
      "name": "Consultations",
      "item": [
        {
          "name": "Get user consultation history",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/{{patientId}}/consultations", "host": ["{{baseUrl}}"], "path": ["users", "{{patientId}}", "consultations"] }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/{{patientId}}/notifications", "host": ["{{baseUrl}}"], "path": ["users", "{{patientId}}", "notifications"] }
          }
        }
      ]
    },
    {
      "name": "Admin/Receptionist",
      "item": [
        {
          "name": "Update doctor availability",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"availability\": \"AVAILABLE\"\n}" },
            "url": { "raw": "{{baseUrl}}/doctors/{{doctorId}}/availability", "host": ["{{baseUrl}}"], "path": ["doctors", "{{doctorId}}", "availability"] }
          }
        }
      ]
    }
  ]
}
