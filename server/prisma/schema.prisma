generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  RECEPTIONIST
  ADMIN
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueEntryStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum ConsultationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  APPOINTMENT
  QUEUE
  CONSULTATION
  SYSTEM
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  passwordHash  String
  role          UserRole
  phone         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  doctor        DoctorProfile?
  patient       PatientProfile?
  appointments  Appointment[]   @relation("PatientAppointments")
  notifications Notification[]
}

model DoctorProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  specialization String?
  availability   AvailabilityStatus @default(AVAILABLE)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments   Appointment[]  @relation("DoctorAppointments")
  consultations  Consultation[]
}

model PatientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Appointment {
  id           String            @id @default(cuid())
  patientId    String
  doctorId     String
  scheduledAt  DateTime
  status       AppointmentStatus @default(BOOKED)
  createdAt    DateTime          @default(now())
  patient      User              @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor       DoctorProfile     @relation("DoctorAppointments", fields: [doctorId], references: [id])
  queueEntry   QueueEntry?
  consultation Consultation?

  @@index([doctorId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([status, scheduledAt])
}

model QueueEntry {
  id            String           @id @default(cuid())
  appointmentId String           @unique
  tokenNumber   Int
  queueDate     DateTime         @db.Date
  status        QueueEntryStatus @default(WAITING)
  issuedAt      DateTime         @default(now())
  calledAt      DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  appointment   Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  consultation  Consultation?

  @@unique([tokenNumber, queueDate])
  @@index([status, issuedAt])
}

model Consultation {
  id            String             @id @default(cuid())
  appointmentId String             @unique
  queueEntryId  String             @unique
  doctorId      String
  status        ConsultationStatus @default(SCHEDULED)
  startedAt     DateTime?
  endedAt       DateTime?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  queueEntry    QueueEntry         @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  doctor        DoctorProfile      @relation(fields: [doctorId], references: [id])

  @@index([doctorId, createdAt])
  @@index([status, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
